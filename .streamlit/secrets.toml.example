# Streamlit Cloud → Settings → Secrets
# NO subas este archivo a Git (usa secrets.toml.example como plantilla).

# ── 1. Cifrado de sesión (OBLIGATORIO en producción web) ─────────────────────
# Genera una clave con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY = "PEGA_AQUI_UNA_CLAVE_FERNET_GENERADA"

# Minutos de inactividad antes de borrar la API key del usuario (default: 30)
SESSION_TIMEOUT_MINUTES = 30

# ── 2. Muro de acceso interno (RECOMENDADO si la app es pública en internet) ─
# Solo quien conozca esta contraseña puede ver la app. Cada usuario sigue usando su propia API key.
APP_PASSWORD = "contraseña_del_equipo_aqui"

# ── 3. API key centralizada del servidor (NO recomendado para equipos) ────────
# Por defecto DESACTIVADA. Solo actívala si eres el único usuario.
ALLOW_SERVER_OPENROUTER_KEY = false
# OPENROUTER_API_KEY = "tu_api_key_aqui"
